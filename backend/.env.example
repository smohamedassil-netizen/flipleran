# ─── Runtime ────────────────────────────────────────────────────────────
PORT=5000
# 'development' | 'staging' | 'production' | 'test'
# En 'production', les seeds de démo et migrations automatiques sont
# strictement désactivés (voir server.js -> runDemoSeedsIfEnabled).
NODE_ENV=development

# ─── Base de données ────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fliplearn?retryWrites=true&w=majority

# ─── Auth ───────────────────────────────────────────────────────────────
JWT_SECRET=<chaine_aleatoire_longue_et_secrete>

# ─── Stockage médias ────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<votre_cloud_name>
CLOUDINARY_API_KEY=<votre_api_key>
CLOUDINARY_API_SECRET=<votre_api_secret>

# ─── IA ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=<votre_groq_api_key>
OPENAI_API_KEY=<optionnel_si_video_AI_agent>

# ─── Front-end ──────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Seeds (dev/staging uniquement) ─────────────────────────────────────
# Opt-in strict : laisser vide ou 'false' désactive les seeds de démo.
# 'true' déclenche au démarrage seedUsers + seedDemoContent + seedDemoData
# + seedProsits. Ignoré si NODE_ENV=production (garde-fou explicite).
# Pour seeder uniquement les badges et rewards (idempotents, requis en
# prod), utiliser le script séparé : `npm run seed:prod`.
SEED_CONTENT=false