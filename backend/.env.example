# ─── Runtime ────────────────────────────────────────────────────────────
PORT=5000
# 'development' | 'staging' | 'production' | 'test'
# En 'production', les seeds de démo et migrations automatiques sont
# strictement désactivés (voir server.js -> runDemoSeedsIfEnabled).
NODE_ENV=development

# ─── Base de données ────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fliplearn?retryWrites=true&w=majority

# ─── Auth ───────────────────────────────────────────────────────────────
JWT_SECRET=<chaine_aleatoire_longue_et_secrete>

# ─── Stockage médias ────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<votre_cloud_name>
CLOUDINARY_API_KEY=<votre_api_key>
CLOUDINARY_API_SECRET=<votre_api_secret>

# ─── IA ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=<votre_groq_api_key>
OPENAI_API_KEY=<optionnel_si_video_AI_agent>

# ─── Front-end ──────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Seeds ──────────────────────────────────────────────────────────────
# SEED_CONTENT='true' déclenche au démarrage seedDemoContent + seedDemoData
# (cours, vidéos, messages de démo). Ignoré si NODE_ENV=production.
#
# NB : seedUsers, seedBadges, seedRewards et seedProsits (cas pratiques
# algériens) sont désormais idempotents et lancés AUTOMATIQUEMENT à chaque
# démarrage du serveur, y compris en production (runProductionSafeSeedsAtStartup
# dans server.js). Plus besoin d'env var pour les avoir en prod sur Render.
SEED_CONTENT=false