PORT=5055

# Clé API Google Cloud Vision (API restreinte à "Cloud Vision API" dans la console GCP)
GOOGLE_VISION_API_KEY=

# Clé API DeepL (plan Free : se termine par ":fx")
DEEPL_API_KEY=
# https://api-free.deepl.com/v2/translate pour un compte Free, https://api.deepl.com/v2/translate pour un compte Pro
DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# Langue cible (code DeepL : FR, EN, etc.)
TARGET_LANG=FR
